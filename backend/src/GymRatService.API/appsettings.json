{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiCoach": {
    "Model": "baidu/ernie-5.5-flash-preview:free",
    "FallbackModel": "google/gemma-4-31b-it:free",
    "Endpoint": "https://openrouter.ai/api/v1"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AuthRateLimit": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 5,
    "RegisterWindowSeconds": 60,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60,
    "FailedLoginLimit": 5,
    "FailedLoginWindowSeconds": 900
  },
  "JwtSettings": {
    "Issuer": "GymRatService",
    "Audience": "GymRatClient",
    "ExpiryMinutes": 15
  },
  "RefreshToken": {
    "CookieName": "gymrat_refresh",
    "LifetimeDays": 30,
    "ReuseGraceSeconds": 10,
    "SameSite": "Strict"
  }
}

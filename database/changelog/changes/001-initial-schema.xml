<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-initial-schema" author="gymrat">
        <createTable tableName="Exercises">
            <column name="Id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="PK_Exercises" nullable="false" />
            </column>
            <column name="Name" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="MainMuscle" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="SubMuscles" type="varchar(200)" />
            <column name="Equipment" type="varchar(50)" />
            <column name="Difficulty" type="varchar(20)" />
            <column name="Description" type="varchar(1000)" />
            <column name="YoutubeLink" type="varchar(200)" />
        </createTable>

        <createIndex tableName="Exercises" indexName="IX_Exercises_Name" unique="true">
            <column name="Name" />
        </createIndex>
    </changeSet>

</databaseChangeLog>

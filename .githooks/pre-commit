#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged() {
  git diff --cached --name-only --no-renames --diff-filter=AM -z -- "$@"
}

mapfile -d '' -t backend < <(staged 'backend/*.cs')
mapfile -d '' -t frontend < <(staged 'frontend/*.ts' 'frontend/*.tsx' 'frontend/*.js' 'frontend/*.jsx' 'frontend/*.mjs' 'frontend/*.cjs')

if ! git diff --cached --check -- backend frontend; then
  echo "Fix the whitespace errors above and stage the files again." >&2
  exit 1
fi

mapfile -d '' -t formatted < <(staged 'frontend/*')

if (( ${#backend[@]} + ${#formatted[@]} == 0 )); then
  exit 0
fi

checkout_staged() {
  printf '%s\0' "$@" | git checkout-index --prefix="$snapshot/" -z --stdin
}

snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT

git ls-files -z -- '.editorconfig' '*/.editorconfig' 'frontend/.oxlintrc.json' 'frontend/.prettierrc.json' 'frontend/.prettierignore' |
  git checkout-index --prefix="$snapshot/" -z --stdin

if (( ${#backend[@]} > 0 )); then
  checkout_staged "${backend[@]}"
  if ! (cd "$snapshot" && dotnet format whitespace backend --folder --verify-no-changes); then
    echo "Format the files above with: dotnet format whitespace backend --folder --include <files>" >&2
    echo "Paths after --include start with backend/. Then stage them again." >&2
    exit 1
  fi
fi

if (( ${#frontend[@]} > 0 )); then
  oxlint="$root/frontend/node_modules/oxlint/bin/oxlint"
  if [[ ! -f "$oxlint" ]]; then
    echo "oxlint is not installed. Run npm install in frontend/." >&2
    exit 1
  fi
  checkout_staged "${frontend[@]}"
  (cd "$snapshot/frontend" && printf '%s\0' "${frontend[@]#frontend/}" |
    xargs -0 -s 20000 node "$oxlint" --config .oxlintrc.json)
fi

if (( ${#formatted[@]} > 0 )); then
  prettier="$root/frontend/node_modules/prettier/bin/prettier.cjs"
  if [[ ! -f "$prettier" ]]; then
    echo "Prettier is not installed. Run npm install in frontend/." >&2
    exit 1
  fi
  checkout_staged "${formatted[@]}"
  if ! (cd "$snapshot/frontend" && printf '%s\0' "${formatted[@]#frontend/}" |
    xargs -0 -s 20000 node "$prettier" --check --ignore-unknown); then
    echo "Format the files above with: npm run format (in frontend/), then stage them again." >&2
    exit 1
  fi
fi
